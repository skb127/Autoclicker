<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Autoclicker.ViewModels"
             xmlns:controls="clr-namespace:Autoclicker.Controls"
             xmlns:views="clr-namespace:Autoclicker.Views"
             xmlns:viewControls="clr-namespace:Autoclicker.Views.Controls"
             x:Class="Autoclicker.Views.MainView"
             x:DataType="vm:MainViewModel">
    <Grid>
        <!-- Main Application Content inside ScrollViewer -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,*,Auto,Auto" Margin="20">

                <!-- ═══════ Header: Title & Settings Gear Button ═══════ -->
                <Grid Grid.Row="0" Grid.ColumnSpan="2" ColumnDefinitions="*,Auto" Margin="0,0,0,16">
                    <TextBlock Grid.ColumnSpan="2"
                               Text="Cross-platform Autoclicker"
                               FontSize="24"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />

                    <Panel Grid.Column="1" VerticalAlignment="Center">
                        <Button Classes="icon"
                                Command="{Binding OpenSettingsCommand}"
                                IsEnabled="{Binding !IsClicking}"
                                ToolTip.Tip="Settings (general, emergency key, logs, about)"
                                AutomationProperties.Name="Settings">
                            <PathIcon Data="{StaticResource SettingsGearGeometry}" Width="18" Height="18" />
                        </Button>
                        <Ellipse Width="9"
                                 Height="9"
                                 Fill="Orange"
                                 HorizontalAlignment="Right"
                                 VerticalAlignment="Top"
                                 Margin="0,2,2,0"
                                 IsHitTestVisible="False"
                                 IsVisible="{Binding IsEmergencyKeyPending}" />
                    </Panel>
                </Grid>

                <!-- ═══════ Left Column: Configuration Expanders ═══════ -->
                <StackPanel Grid.Row="1" Grid.Column="0" Spacing="10" Margin="0,0,10,0">

                    <!-- 1. Interval & Repetitions -->
                    <Expander Header="Interval &amp; Repetitions" IsExpanded="True" HorizontalAlignment="Stretch">
                        <StackPanel Spacing="8">
                            <TextBlock Text="Interval / Min interval (ms):"
                                       ToolTip.Tip="Measured start-to-start between consecutive actions." />
                            <controls:IntegerUpDown IntValue="{Binding MinIntervalMs}" Minimum="1" Maximum="60000"
                                                    Increment="50" IsEnabled="{Binding !IsClicking}" />

                            <CheckBox Content="Randomize interval (range)"
                                      IsChecked="{Binding RandomizeInterval}"
                                      IsEnabled="{Binding !IsClicking}" />

                            <StackPanel Spacing="4" IsVisible="{Binding RandomizeInterval}">
                                <TextBlock Text="Max interval (ms):" />
                                <controls:IntegerUpDown IntValue="{Binding MaxIntervalMs}"
                                                        Minimum="{Binding MinIntervalMs}" Maximum="60000"
                                                        Increment="50" IsEnabled="{Binding !IsClicking}" />
                            </StackPanel>

                            <TextBlock FontSize="11" Foreground="Gray" TextWrapping="Wrap"
                                       Text="ℹ️ Start-to-start timing: the interval is measured from the start of one action to the start of the next. If a hold or human movement takes longer than the interval, the next action starts immediately after." />

                            <TextBlock Text="Repetitions (0 = Infinite Loop):" Margin="0,4,0,0" />
                            <controls:IntegerUpDown IntValue="{Binding Repetitions}" Minimum="0" Maximum="9999"
                                                    Increment="1" IsEnabled="{Binding !IsClicking}" />
                        </StackPanel>
                    </Expander>

                    <!-- 2. Click Action & Button -->
                    <Expander Header="Click Action &amp; Button" IsExpanded="True" HorizontalAlignment="Stretch">
                        <StackPanel Spacing="8">
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                                <StackPanel Grid.Column="0" Spacing="4">
                                    <TextBlock Text="Mouse Button:" />
                                    <ComboBox ItemsSource="{Binding AvailableButtons}"
                                              SelectedItem="{Binding SelectedButton}"
                                              IsEnabled="{Binding CanSelectMouseButton}"
                                              HorizontalAlignment="Stretch" />
                                </StackPanel>

                                <StackPanel Grid.Column="1" Spacing="4">
                                    <TextBlock Text="Action Type:" />
                                    <ComboBox ItemsSource="{Binding AvailableActions}"
                                              SelectedItem="{Binding SelectedAction}"
                                              IsEnabled="{Binding !IsClicking}"
                                              HorizontalAlignment="Stretch" />
                                </StackPanel>
                            </Grid>

                            <StackPanel Spacing="4" IsVisible="{Binding IsHoldSelected}">
                                <TextBlock Text="Hold duration (ms):" />
                                <controls:IntegerUpDown IntValue="{Binding HoldMs}" Minimum="1" Maximum="60000"
                                                        Increment="50" IsEnabled="{Binding !IsClicking}" />
                            </StackPanel>

                            <TextBlock FontSize="11" Foreground="Gray" TextWrapping="Wrap"
                                       IsVisible="{Binding IsDragSelected}"
                                       Text="ℹ️ Drag mode (Left button only) presses at the 1st coordinate, drags through the subsequent coordinates in the pattern, and releases at the final point (requires at least 2 coordinates)." />
                        </StackPanel>
                    </Expander>

                    <!-- 3. Movement & Jitter -->
                    <Expander Header="Movement &amp; Jitter" IsExpanded="True" HorizontalAlignment="Stretch">
                        <StackPanel Spacing="8">
                            <CheckBox Content="Human-like mouse movement (WindMouse)"
                                      IsChecked="{Binding HumanMovement}"
                                      IsEnabled="{Binding !IsClicking}" />

                            <StackPanel Spacing="4" IsVisible="{Binding HumanMovement}">
                                <TextBlock Text="Movement speed:" />
                                <ComboBox ItemsSource="{Binding AvailableSpeeds}"
                                          SelectedItem="{Binding MovementSpeed}"
                                          IsEnabled="{Binding !IsClicking}"
                                          HorizontalAlignment="Stretch" />
                            </StackPanel>

                            <Border Background="#33FFA500" BorderBrush="Orange" BorderThickness="1"
                                    CornerRadius="4" Padding="8"
                                    IsVisible="{Binding IsShortIntervalWarningVisible}">
                                <TextBlock FontSize="11" TextWrapping="Wrap"
                                           Text="⚠️ Human-like movement typically takes 150–450 ms per stroke. Because your interval is under 300 ms, the effective pace will be limited by the movement duration." />
                            </Border>

                            <TextBlock Text="Coordinate jitter (± px, 0 = exact):" Margin="0,4,0,0" />
                            <controls:IntegerUpDown IntValue="{Binding JitterPx}" Minimum="0" Maximum="50"
                                                    Increment="1" IsEnabled="{Binding !IsClicking}" />
                        </StackPanel>
                    </Expander>
                </StackPanel>

                <!-- ═══════ Right Column: Pattern Sequence ═══════ -->
                <StackPanel Grid.Row="1" Grid.Column="1" Spacing="10" Margin="10,0,0,0">
                    <Expander Header="Click Sequence (Pattern)" IsExpanded="True" HorizontalAlignment="Stretch">
                        <StackPanel Spacing="8">
                            <TextBlock FontSize="11" Foreground="Gray" TextWrapping="Wrap"
                                       Text="Tip: Drag and drop coordinates to reorder, or press Delete to remove the selected item." />

                            <ListBox x:Name="PatternListBox"
                                     ItemsSource="{Binding ClickPatterns}"
                                     SelectedIndex="{Binding SelectedPatternIndex}"
                                     DragDrop.AllowDrop="True"
                                     Focusable="True"
                                     Height="220">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <TextBlock Text="⠿" Foreground="Gray" VerticalAlignment="Center" />
                                            <TextBlock Text="X:" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding X}" />
                                            <TextBlock Text="  Y:" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Y}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="8">
                                <Button Grid.Column="0" Content="▲ Up"
                                        Command="{Binding MovePatternUpCommand}"
                                        IsEnabled="{Binding CanMovePatternUp}"
                                        ToolTip.Tip="Move selected coordinate up" />
                                <Button Grid.Column="1" Content="▼ Down"
                                        Command="{Binding MovePatternDownCommand}"
                                        IsEnabled="{Binding CanMovePatternDown}"
                                        ToolTip.Tip="Move selected coordinate down" />
                                <Button Grid.Column="2" Content="✕ Remove Selected"
                                        Command="{Binding RemoveSelectedPatternCommand}"
                                        IsEnabled="{Binding CanRemoveSelectedPattern}"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Center" />
                            </Grid>

                            <Button Content="Add Coordinate to Pattern"
                                    Command="{Binding CaptureCoordinateCommand}"
                                    IsEnabled="{Binding !IsClicking}"
                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />

                            <Grid ColumnDefinitions="Auto,*,Auto,*,Auto" ColumnSpacing="6">
                                <TextBlock Grid.Column="0" Text="X:" VerticalAlignment="Center" />
                                <controls:IntegerUpDown Grid.Column="1"
                                                        IntValue="{Binding ManualX}"
                                                        Minimum="-32768" Maximum="32767"
                                                        Increment="1"
                                                        IsEnabled="{Binding !IsClicking}" />
                                <TextBlock Grid.Column="2" Text="Y:" VerticalAlignment="Center" />
                                <controls:IntegerUpDown Grid.Column="3"
                                                        IntValue="{Binding ManualY}"
                                                        Minimum="-32768" Maximum="32767"
                                                        Increment="1"
                                                        IsEnabled="{Binding !IsClicking}" />
                                <Button Grid.Column="4" Content="+ Add"
                                        Command="{Binding AddManualCoordinateCommand}"
                                        IsEnabled="{Binding !IsClicking}"
                                        ToolTip.Tip="Add manual screen coordinate" />
                            </Grid>

                            <Button Content="Clear Pattern"
                                    Command="{Binding ClearPatternCommand}"
                                    IsEnabled="{Binding !IsClicking}"
                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
                        </StackPanel>
                    </Expander>
                </StackPanel>

                <!-- ═══════ Wayland Emergency Key Status Banner (only visible on Wayland) ═══════ -->

                <!-- 1. Pending state: prominent orange banner explaining why Start is disabled -->
                <Border Grid.Row="2" Grid.ColumnSpan="2" Grid.Column="0"
                        IsVisible="{Binding IsEmergencyKeyPending}"
                        Background="#33FFA500"
                        BorderBrush="Orange"
                        BorderThickness="2"
                        CornerRadius="6"
                        Padding="14,12"
                        Margin="0,14,0,0">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
                        <StackPanel Grid.Column="0" Spacing="4">
                            <TextBlock Text="⚠️ Emergency stop key not verified"
                                       FontWeight="Bold"
                                       FontSize="14" />
                            <TextBlock FontSize="12"
                                       TextWrapping="Wrap"
                                       Text="On Wayland, Autoclicker can't listen for a stop key by itself. Start is disabled until you press your system shortcut once (required every session)." />
                        </StackPanel>

                        <Button Grid.Column="1"
                                Content="Set up…"
                                Command="{Binding OpenEmergencyKeySettingsCommand}"
                                FontWeight="SemiBold"
                                Padding="14,6"
                                VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <!-- 2. Ready state: compact green confirmation bar -->
                <Border Grid.Row="2" Grid.ColumnSpan="2" Grid.Column="0"
                        IsVisible="{Binding IsWaylandEmergencyKeyReady}"
                        Background="#1E22C55E"
                        BorderBrush="#22C55E"
                        BorderThickness="1"
                        CornerRadius="5"
                        Padding="12,8"
                        Margin="0,14,0,0">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <TextBlock Text="✔ Emergency stop active"
                                       Foreground="#22C55E"
                                       FontWeight="Bold"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="— press your shortcut at any time to stop."
                                       FontSize="12"
                                       Opacity="0.85"
                                       VerticalAlignment="Center" />
                        </StackPanel>

                        <Button Grid.Column="1"
                                Content="Settings"
                                Command="{Binding OpenEmergencyKeySettingsCommand}"
                                FontSize="12"
                                Padding="10,4"
                                VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <!-- ═══════ Start / Stop Buttons ═══════ -->
                <StackPanel Grid.Row="3" Grid.ColumnSpan="2" Grid.Column="0" Orientation="Horizontal"
                            HorizontalAlignment="Center" Spacing="20" Margin="0,20,0,0">
                    <Button Content="Start Autoclick"
                            Command="{Binding StartAutoclickCommand}"
                            IsEnabled="{Binding CanStartAutoclick}"
                            ToolTip.Tip="{Binding StartDisabledReason}"
                            ToolTip.ShowOnDisabled="True"
                            Width="160" HorizontalContentAlignment="Center" />

                    <Button Content="Stop (Or press ESCAPE)"
                            Command="{Binding StopAutoclickCommand}"
                            IsEnabled="{Binding IsClicking}"
                            Width="180" HorizontalContentAlignment="Center" />
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <!-- ═══════ Settings Modal Overlay ═══════ -->
        <views:SettingsView DataContext="{Binding Settings}"
                            IsVisible="{Binding IsOpen}"
                            ZIndex="50" />

        <!-- ═══════ Modal Message Dialog Overlay ═══════ -->
        <viewControls:MessageDialog Message="{Binding ActiveDialog}"
                                    CloseCommand="{Binding CloseDialogCommand}"
                                    ZIndex="100" />
    </Grid>
</UserControl>
